{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SheetNative",
  "version": "1.0.0",
  "identifier": "com.sheetnative.desktop",
  "build": {
    "frontendDist": "../../.next/standalone",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "title": "SheetNative — AI Business OS",
    "windows": [
      {
        "title": "SheetNative",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": { "iconPath": "icons/icon.png", "iconAsTemplate": true }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
