{
  "expo": {
    "name": "SheetNative",
    "slug": "sheetnative",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sheetnative",
    "icon": "../shared/icon-1024.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090f",
    "splash": {
      "image": "../shared/splash-1284.png",
      "resizeMode": "cover",
      "backgroundColor": "#07090f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.sheetnative.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SheetNative uses the camera to scan receipts, invoices and barcodes into your business apps.",
        "NSPhotoLibraryUsageDescription": "SheetNative uses your photo library to attach images to records.",
        "NSLocationWhenInUseUsageDescription": "GPS check-ins, route tracking and delivery proof."
      }
    },
    "android": {
      "package": "com.sheetnative.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "../shared/icon-1024.png",
        "backgroundColor": "#07090f"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "eas": { "projectId": "" }
    }
  }
}
